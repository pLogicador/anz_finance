# Copy to .env for local dev. Never commit the real .env.

# subscription_access_api base URL. For day-to-day local iteration, point
# this at the local mock server (see tests/fixtures/mock_syncron.py) instead
# of a real/staging instance -- see the plan's "Dev local" section.
SYNCRON_API_BASE=http://localhost:8000

# ANZ's own JWT signing secret -- independent from subscription_access_api's
# secret. Generate a real random value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

WORKSPACE_TTL_MINUTES=60

# Origin of the frontend dev server / deployed frontend, used for CORS.
FRONTEND_URL=http://localhost:5173

# -- AI classification/assistant (Fase 3 + Fase 5) --------------------
# Operator-provided defaults, used whenever a request doesn't supply its
# own key (PARTE 6.2, "usar minha própria chave" in the frontend). Leaving
# either blank is a supported, tested configuration: classification then
# degrades each transaction to "Erro na classificação" instead of failing
# the whole upload (see app/pipeline/categorizer/registry.py), and the
# explicit AI actions (test-connection/ask) return a clear 400 asking the
# user to supply their own key instead.
GROQ_API_KEY=
OPENAI_API_KEY=
